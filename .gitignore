__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store
Thumbs.db
.vscode/
.idea/
.env
.venv/
pipeline.log
fonts/
logs/
scratch/
client_secrets.json
token.json
credentials/
# Ignore compiled media by default
*.mp4
!samples/End_Credits_Videos/*.mp4
*.mp3
!samples/Audio/track_01.mp3
!samples/Audio/track_02.mp3
!samples/Audio/track_03.mp3

# Ignore extra audio tracks beyond baseline 3
samples/Audio/track_0[4-9].mp3
samples/Audio/track_1[0-9].mp3
**/samples/Templates/
samples/Templates/

# Ignore compiled media in the archive
pulse_archive/**/*.png
pulse_archive/**/*.jpg
pulse_archive/**/*.jpeg
pulse_archive/**/*.mp4
pulse_archive/**/*.mp3
pulse_archive/**/*.wav
pulse_archive/temp_end_frames/
**/tts_temp/
reports/

# Prevent accidental Linux runner drive path tracking
G:*
"G:*"
*G:\*
