# ==========================================
# Pulse Vector - Environment Configuration
# Copy this file to .env and populate keys
# ==========================================

# Google Gemini AI & Core Pipeline
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here

# YouTube Data API v3
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_PLAYLIST_TAG=Daily Current Affairs

# Supabase Cloud Database & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
ENABLE_SUPABASE_STORAGE_UPLOAD=true

# Community Broadcast Integrations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=@pulsevector_daily
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Meta Developer & Instagram Graph API (v21.0)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_60_day_long_lived_user_or_page_token_here
INSTAGRAM_ACCOUNT_ID=your_numeric_instagram_business_account_id_here
PULSE_INSTAGRAM_URL=https://www.instagram.com/pulse_vector

# Email Monitoring & Reporting (SMTP)
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
REPORT_RECIPIENT_EMAIL=your_email@gmail.com

# Local Directory Overrides (Optional)
PULSE_ARCHIVE_DIR=pulse_archive
PULSE_INPUT_DIR=incoming_data
ENABLE_GDRIVE_UPLOAD=false
